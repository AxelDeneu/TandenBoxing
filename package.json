{
  "name": "tanden-boxing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coach de boxe à domicile — séances quotidiennes générées par IA, timer à intervalles et suivi de progression.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "prepare": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:prod": "node scripts/audit-production-dependencies.mjs",
    "eval:generator": "tsx evaluation/cli.ts",
    "eval:generator:real": "tsx evaluation/real/cli.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.2",
    "@openrouter/sdk": "^1.4.2",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "nostics": "^1.3.0",
    "nuxt": "^4.5.2",
    "vue": "3.5.43",
    "vue-chartjs": "^5.3.3",
    "vue-router": "5.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.137",
    "@nuxt/eslint": "^1.17.0",
    "@types/better-sqlite3": "^7.6.13",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/server-renderer": "3.5.43",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
