# --- Tanden Boxing — variables d'environnement ---
# Copier en `.env` et renseigner les valeurs.

# Clé API OpenRouter (OBLIGATOIRE pour la génération des séances et le catalogue)
# https://openrouter.ai/settings/keys
NUXT_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Métadonnées OpenRouter optionnelles (recommandées en production)
NUXT_OPENROUTER_HTTP_REFERER=https://boxing.example.com
NUXT_OPENROUTER_APP_TITLE=Tanden Boxing

# Politique par défaut : endpoints Zero Data Retention uniquement.
# Mettre à 0 uniquement après validation explicite de la politique de confidentialité.
NUXT_OPENROUTER_REQUIRE_ZDR=1

# Modèle utilisé pour générer les séances
NUXT_AI_MODEL=anthropic/claude-opus-4.8

# Fuseau horaire (utilisé par le cron de génération 7h)
NUXT_TIMEZONE=Europe/Paris

# Chemin du fichier SQLite (monter un volume persistant ici en prod)
NUXT_DATABASE_PATH=./data/tanden.db

# Mettre à 1 pour désactiver le cron (utile en dev)
# NUXT_DISABLE_CRON=1
